# Nunca preencha segredos neste arquivo versionado. Use arquivo fora da release (0600).
# Runtime obrigatório; segredo próprio, aleatório, >=32 caracteres. Não use chaves Supabase.
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Origem canônica em produção: HTTPS, sem caminho/query; domínio é definido pelo operador.
APP_URL="https://REPLACE_WITH_DOMAIN"

# DATABASE_URL: runtime Prisma. Copie Connect do Supabase, encode a senha como URL.
# Transaction Pooler 6543: pgbouncer=true. Session Pooler 5432 também é suportado.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=strict&connection_limit=5&pool_timeout=5&connect_timeout=5"
# DIRECT_URL: inspeção/migrations; direta ou Session Pooler 5432, nunca Transaction Pooler.
DIRECT_URL="postgresql://postgres:PASSWORD_URL_ENCODED@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&sslaccept=strict&connect_timeout=5"
# Session Pooler alternativo: host/usuário exatos do painel Supabase, porta 5432.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:5432/postgres?sslmode=require&sslaccept=strict&connect_timeout=5"

# Produção: NODE_ENV=production. Desenvolvimento: NODE_ENV=development, APP_URL opcional.
# Local: configure AMBAS as URLs para PostgreSQL local; sem TLS apenas em loopback.
# DATABASE_URL="postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:LOCAL_PORT/LOCAL_DATABASE"
# DIRECT_URL="postgresql://LOCAL_USER:LOCAL_PASSWORD@127.0.0.1:LOCAL_PORT/LOCAL_DATABASE"
# Testes: obrigatório banco descartável loopback com nome _test; nunca Supabase.
# TEST_DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:TEST_PORT/fuctura_local_test"

# Opcionais operacionais (não necessárias ao domínio acadêmico):
# NEXT_TELEMETRY_DISABLED=1
# PORT=REPLACE_WITH_LOCAL_PORT
# HOSTNAME=127.0.0.1
# DISABLE_HMR=false                    # desenvolvimento AI Studio somente
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium # testes com navegador local
# SUPABASE_DATABASE_URL=...            # diagnóstico legado de leitura; não é runtime
# GEMINI_API_KEY não é usado pela aplicação atual; não há IA neste marco.

# Homologação: NODE_ENV continua production; APP_ENV identifica o ambiente separado.
# APP_ENV=staging
# HOMOLOGATION_APP_STOPPED=1 # confirmar somente após parar serviço de homologação
# HOMOLOGATION_APPROVAL_FILE=/REPLACE_PRIVATE_PATH/approval.json
# HOMOLOGATION_ACCOUNT_PASSWORD=REPLACE_DISTINCT_FICTIONAL_PASSWORD
# HOMOLOGATION_BASE_DATE=REPLACE_YYYY_MM_DD
# HOMOLOGATION_AUCTION_ENDS_AT=REPLACE_FUTURE_ISO_DATETIME
# STAGING_GATE_USER=REPLACE_ADDITIONAL_AUTH_USER
# STAGING_GATE_PASSWORD=REPLACE_ADDITIONAL_AUTH_PASSWORD
# STAGING_DIRECTOR_SESSION=REPLACE_SHORT_LIVED_STAGING_DIRECTOR_JWT # somente verificação autenticada
