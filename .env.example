# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Connection String (Supabase):
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Modo Pooler (Recomendado para Serverless/Next.js - porta 6543):
# postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Modo Conexão Direta (porta 5432):
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secret used to sign session tokens securely
AUTH_SECRET="fuctura-auth-secret-troque-em-producao-123456789"

