# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Prisma PostgreSQL (copie os valores exatos de "Connect" no projeto Supabase).
# DATABASE_URL: aplicação Next.js. Transaction Pooler usa porta 6543.
# Credenciais abaixo são marcadores; substitua somente no arquivo ignorado/secret manager.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&sslaccept=strict"

# DIRECT_URL: ferramentas Prisma. Use conexão direta, se houver IPv6 alcançável,
# ou o Session Pooler em 5432 copiado do painel quando a máquina tiver apenas IPv4.
# Não use Transaction Pooler (6543) para operações de schema/migrations.
DIRECT_URL="postgresql://postgres:PASSWORD_URL_ENCODED@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&sslaccept=strict"
# Alternativa Session Pooler (host/usuário exatos do painel, porta 5432):
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD_URL_ENCODED@POOLER_HOST:5432/postgres?sslmode=require&sslaccept=strict"

# PostgreSQL local: configure AMBAS as URLs para seu banco local, sem parâmetros TLS
# se o servidor de desenvolvimento não oferecer SSL. Nunca reutilize o remoto em testes.
# TEST_DATABASE_URL é exclusivamente um banco isolado local com nome terminado em _test.

# AUTH_SECRET é próprio da aplicação para assinar sessões; não é chave da API Supabase.
# Gere um valor aleatório longo (por exemplo: openssl rand -hex 32) e guarde como segredo.
AUTH_SECRET="REPLACE_WITH_A_RANDOM_APPLICATION_SECRET"
